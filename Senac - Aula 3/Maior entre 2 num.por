programa {
  funcao inicio() {

    inteiro n1, n2 
  escreva("Digite um numero: ")
  leia(n1)
  escreva("Digite outro numero: ")
  leia(n2)

  se (n1 > n2){
    escreva("O primeiro numero ", n1, " e maior que o segundo numero ", n2," !")
  } senao se (n1 == n2){
    escreva("Os numeros sao iguais!")

  }senao{
    escreva("O numero segundo numero e maior!")
  }
    
  }
}
